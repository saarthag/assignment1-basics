# Copy this to `.env` and fill in real values.
# `.env` is git-ignored — never commit real credentials.
#
# Load it before running, e.g.:
#     set -a; . ./.env; set +a
#     uv run --env-file .env python -m cs336_basics.train -c train_config.toml

# --- S3-compatible storage (Cloudflare R2) ---------------------------------- #
# Access Key ID and Secret Access Key from an R2 API token (Object Read & Write).
# Both are required; one without the other fails with PartialCredentialsError.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: only for temporary/session credentials.
# AWS_SESSION_TOKEN=
# S3 endpoint, e.g. https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_ENDPOINT_URL=
# Optional: region for signing (storage defaults to "auto", correct for R2).
# AWS_DEFAULT_REGION=auto
# Aliases also accepted by cs336_basics/storage.py:
#   S3_ENDPOINT_URL, S3_REGION

# --- Weights & Biases ------------------------------------------------------- #
# API key so `wandb.init()` runs non-interactively on the GPU instance.
WANDB_API_KEY=
# Optional: "online" (default), "offline" (log locally, `wandb sync` later), or "disabled".
# WANDB_MODE=online
# Optional: override the entity/project (normally set in the training config).
# WANDB_ENTITY=
# WANDB_PROJECT=cs336n
